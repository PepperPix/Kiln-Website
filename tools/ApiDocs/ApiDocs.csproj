<Project Sdk="Microsoft.NET.Sdk">

  <!-- Only downloads the packages the API reference is generated from; nothing is built. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <KilnVersion Condition="'$(KilnVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../api-docs.version').Trim())</KilnVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Kiln.Core" Version="[$(KilnVersion)]" />
    <PackageDownload Include="Kiln.Abstractions" Version="[$(KilnVersion)]" />
  </ItemGroup>

</Project>
