<Project Sdk="Microsoft.NET.Sdk">

  <!-- Only downloads the packages the API reference is generated from; nothing is built. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EngobeVersion Condition="'$(EngobeVersion)' == ''">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../api-docs.version').Trim())</EngobeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Engobe.Core" Version="[$(EngobeVersion)]" />
    <PackageDownload Include="Engobe.Abstractions" Version="[$(EngobeVersion)]" />
  </ItemGroup>

</Project>
